# TrainMyBrain AI API Configuration (Template)
# Copy this file to .env and insert your private API keys.

# OpenAI API Key (e.g. sk-proj-...)
VITE_OPENAI_API_KEY=

# Google Gemini API Key (e.g. AIzaSy...)
VITE_GEMINI_API_KEY=

# Custom Backend Proxy URL (for production security)
VITE_AI_BACKEND_URL=https://api.yourdomain.com/api/ai
